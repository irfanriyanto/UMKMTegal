# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env on your production server and update the values.
# IMPORTANT: Never commit .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME="UMKM Lokal"
APP_ENV=production
APP_KEY=                                    # Generate with: php artisan key:generate
APP_DEBUG=false                             # MUST be false in production!
APP_URL=https://yourdomain.com              # Your production domain with HTTPS

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=Asia/Jakarta

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12                            # Higher = more secure but slower

# -----------------------------------------------------------------------------
# Logging (Production)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                           # Use 'warning' or 'error' in production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                           # Update with your database host
DB_PORT=3306
DB_DATABASE=umkm_db                         # Update with your database name
DB_USERNAME=                                # Update with your database username
DB_PASSWORD=                                # Update with a strong password!

# -----------------------------------------------------------------------------
# Session Security (Production)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true                        # MUST be true in production!
SESSION_PATH=/
SESSION_DOMAIN=null                         # Set to your domain if needed
SESSION_SECURE_COOKIE=true                  # MUST be true when using HTTPS!
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Cache & Queue
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Mail Configuration
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp                            # Use 'smtp' for production
MAIL_HOST=                                  # Your SMTP host
MAIL_PORT=587                               # Usually 587 for TLS
MAIL_USERNAME=                              # Your SMTP username
MAIL_PASSWORD=                              # Your SMTP password
MAIL_ENCRYPTION=tls                         # Use 'tls' or 'ssl'
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# PRODUCTION CHECKLIST
# -----------------------------------------------------------------------------
# Before deploying, ensure:
# [ ] APP_DEBUG is set to false
# [ ] APP_KEY is generated and set
# [ ] APP_URL uses HTTPS
# [ ] SESSION_ENCRYPT is true
# [ ] SESSION_SECURE_COOKIE is true
# [ ] Database credentials are secure
# [ ] Mail configuration is set up
# [ ] LOG_LEVEL is 'warning' or 'error'
# [ ] SSL certificate is installed
# [ ] File permissions are correct (storage, bootstrap/cache)
# =============================================================================
